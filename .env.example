# Copy to .env and fill in. .env is git-ignored; never commit it.
# Read by bin/submit.sh, run_experiment.py and docker compose.

# --- Required ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
# Existing S3 bucket; the tables are written under s3://<bucket>/<S3_WAREHOUSE_PREFIX>/
S3_BUCKET_NAME=

# --- Optional (defaults shown) ---
#S3_WAREHOUSE_PREFIX=test-spark
#REST_PORT=8181
#REST_URI=http://localhost:8181     # overrides REST_PORT, e.g. for a catalog on another host
#SPARK_DRIVER_MEMORY=4g
#COMPOSE_PROJECT_NAME=metabench
